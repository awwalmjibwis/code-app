import 'package:flutter/material.dart';

class EconomicCalendarScreen extends StatefulWidget {
  const EconomicCalendarScreen({super.key});

  @override
  State<EconomicCalendarScreen> createState() =>
      _EconomicCalendarScreenState();
}

class _EconomicCalendarScreenState
    extends State<EconomicCalendarScreen> {
  String _selectedImpact = "All";

  final List<Map<String, dynamic>> _events = [
    {
      "currency": "USD",
      "title": "Non-Farm Payroll (NFP)",
      "date": "07 Aug 2026",
      "time": "1:30 PM",
      "impact": "High",
      "forecast": "180K",
      "previous": "175K",
      "actual": "--",
    },
    {
      "currency": "EUR",
      "title": "ECB Interest Rate Decision",
      "date": "07 Aug 2026",
      "time": "2:15 PM",
      "impact": "High",
      "forecast": "2.15%",
      "previous": "2.25%",
      "actual": "--",
    },
    {
      "currency": "GBP",
      "title": "GDP Report",
      "date": "08 Aug 2026",
      "time": "9:00 AM",
      "impact": "Medium",
      "forecast": "0.3%",
      "previous": "0.2%",
      "actual": "--",
    },
    {
      "currency": "USD",
      "title": "Consumer Price Index (CPI)",
      "date": "09 Aug 2026",
      "time": "1:30 PM",
      "impact": "High",
      "forecast": "2.8%",
      "previous": "3.0%",
      "actual": "--",
    },
    {
      "currency": "AUD",
      "title": "Employment Change",
      "date": "10 Aug 2026",
      "time": "2:30 AM",
      "impact": "Low",
      "forecast": "15K",
      "previous": "12K",
      "actual": "--",
    },
  ];

  List<Map<String, dynamic>> get _filteredEvents {
    if (_selectedImpact == "All") {
      return _events;
    }

    return _events.where((event) {
      return event["impact"] == _selectedImpact;
    }).toList();
  }

  Color _impactColor(String impact) {
    switch (impact) {
      case "High":
        return Colors.redAccent;
      case "Medium":
        return Colors.orange;
      case "Low":
        return Colors.green;
      default:
        return Colors.blue;
    }
  }

  void _showEventDetails(Map<String, dynamic> event) {
    final impactColor = _impactColor(event["impact"]);

    showModalBottomSheet(
      context: context,
      backgroundColor: const Color(0xFF1E1E1E),
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(
          top: Radius.circular(24),
        ),
      ),
      builder: (context) {
        return Padding(
          padding: const EdgeInsets.all(24),
          child: SafeArea(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    CircleAvatar(
                      radius: 28,
                      backgroundColor:
                          impactColor.withValues(alpha: 0.15),
                      child: Text(
                        event["currency"],
                        style: TextStyle(
                          color: impactColor,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                    const SizedBox(width: 14),
                    Expanded(
                      child: Text(
                        event["title"],
                        style: const TextStyle(
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ],
                ),

                const SizedBox(height: 20),

                Row(
                  children: [
                    const Icon(
                      Icons.calendar_month,
                      color: Colors.blue,
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    Text(event["date"]),
                    const SizedBox(width: 20),
                    const Icon(
                      Icons.access_time,
                      color: Colors.orange,
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    Text(event["time"]),
                  ],
                ),

                const SizedBox(height: 18),

                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 8,
                  ),
                  decoration: BoxDecoration(
                    color:
                        impactColor.withValues(alpha: 0.12),
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(
                        Icons.circle,
                        size: 10,
                        color: impactColor,
                      ),
                      const SizedBox(width: 8),
                      Text(
                        "${event["impact"]} Impact",
                        style: TextStyle(
                          color: impactColor,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 24),

                _detailRow(
                  "Actual",
                  event["actual"],
                ),
                _detailRow(
                  "Forecast",
                  event["forecast"],
                ),
                _detailRow(
                  "Previous",
                  event["previous"],
                ),

                const SizedBox(height: 20),

                SizedBox(
                  width: double.infinity,
                  child: ElevatedButton(
                    onPressed: () {
                      Navigator.pop(context);
                    },
                    child: const Text("Close"),
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _detailRow(String label, String value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 12),
      child: Row(
        mainAxisAlignment:
            MainAxisAlignment.spaceBetween,
        children: [
          Text(
            label,
            style: const TextStyle(
              color: Colors.white60,
            ),
          ),
          Text(
            value,
            style: const TextStyle(
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "Economic Calendar",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
      ),
      body: Column(
        children: [
          const Padding(
            padding: EdgeInsets.fromLTRB(
              16,
              16,
              16,
              8,
            ),
            child: Align(
              alignment: Alignment.centerLeft,
              child: Text(
                "Market Events",
                style: TextStyle(
                  fontSize: 21,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),

          SizedBox(
            height: 55,
            child: ListView(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.symmetric(
                horizontal: 16,
                vertical: 8,
              ),
              children: [
                _filterChip("All"),
                _filterChip("High"),
                _filterChip("Medium"),
                _filterChip("Low"),
              ],
            ),
          ),

          Expanded(
            child: ListView.builder(
              padding: const EdgeInsets.fromLTRB(
                16,
                8,
                16,
                20,
              ),
              itemCount: _filteredEvents.length,
              itemBuilder: (context, index) {
                final event = _filteredEvents[index];

                return Padding(
                  padding:
                      const EdgeInsets.only(bottom: 12),
                  child: _eventCard(event),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget _filterChip(String impact) {
    final selected = _selectedImpact == impact;

    return Padding(
      padding: const EdgeInsets.only(right: 8),
      child: ChoiceChip(
        label: Text(impact),
        selected: selected,
        onSelected: (_) {
          setState(() {
            _selectedImpact = impact;
          });
        },
      ),
    );
  }

  Widget _eventCard(Map<String, dynamic> event) {
    final impactColor = _impactColor(event["impact"]);

    return Card(
      elevation: 4,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
      ),
      child: InkWell(
        borderRadius: BorderRadius.circular(18),
        onTap: () => _showEventDetails(event),
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Row(
            crossAxisAlignment:
                CrossAxisAlignment.start,
            children: [
              CircleAvatar(
                radius: 28,
                backgroundColor:
                    impactColor.withValues(alpha: 0.15),
                child: Text(
                  event["currency"],
                  style: TextStyle(
                    color: impactColor,
                    fontWeight: FontWeight.bold,
                    fontSize: 12,
                  ),
                ),
              ),

              const SizedBox(width: 14),

              Expanded(
                child: Column(
                  crossAxisAlignment:
                      CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Expanded(
                          child: Text(
                            event["title"],
                            style: const TextStyle(
                              fontSize: 16,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ),
                        Icon(
                          Icons.circle,
                          size: 10,
                          color: impactColor,
                        ),
                      ],
                    ),

                    const SizedBox(height: 8),

                    Row(
                      children: [
                        const Icon(
                          Icons.calendar_month,
                          size: 15,
                          color: Colors.white54,
                        ),
                        const SizedBox(width: 5),
                        Text(
                          event["date"],
                          style: const TextStyle(
                            color: Colors.white60,
                            fontSize: 12,
                          ),
                        ),
                      ],
                    ),

                    const SizedBox(height: 5),

                    Row(
                      children: [
                        const Icon(
                          Icons.access_time,
                          size: 15,
                          color: Colors.white54,
                        ),
                        const SizedBox(width: 5),
                        Text(
                          event["time"],
                          style: const TextStyle(
                            color: Colors.white60,
                            fontSize: 12,
                          ),
                        ),
                        const SizedBox(width: 14),
                        Text(
                          "${event["impact"]} Impact",
                          style: TextStyle(
                            color: impactColor,
                            fontSize: 12,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                    ),

                    const SizedBox(height: 10),

                    Row(
                      children: [
                        _miniValue(
                          "Forecast",
                          event["forecast"],
                        ),
                        const SizedBox(width: 12),
                        _miniValue(
                          "Previous",
                          event["previous"],
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _miniValue(String label, String value) {
    return Column(
      crossAxisAlignment:
          CrossAxisAlignment.start,
      children: [
        Text(
          label,
          style: const TextStyle(
            color: Colors.white38,
            fontSize: 11,
          ),
        ),
        const SizedBox(height: 2),
        Text(
          value,
          style: const TextStyle(
            fontWeight: FontWeight.bold,
            fontSize: 12,
          ),
        ),
      ],
    );
  }
}