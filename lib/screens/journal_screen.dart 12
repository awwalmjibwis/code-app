import 'package:flutter/material.dart';

class JournalScreen extends StatefulWidget {
  const JournalScreen({super.key});

  @override
  State<JournalScreen> createState() => _JournalScreenState();
}

class _JournalScreenState extends State<JournalScreen> {
  final List<TradeEntry> _trades = [];

  void _showAddTradeDialog() {
    final symbolController = TextEditingController();
    final entryController = TextEditingController();
    final exitController = TextEditingController();
    final profitLossController = TextEditingController();

    String tradeType = "BUY";

    showDialog(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text("Add Trade"),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TextField(
                      controller: symbolController,
                      textCapitalization:
                          TextCapitalization.characters,
                      decoration: const InputDecoration(
                        labelText: "Symbol",
                        hintText: "Example: XAU/USD",
                        prefixIcon: Icon(Icons.currency_exchange),
                        border: OutlineInputBorder(),
                      ),
                    ),

                    const SizedBox(height: 12),

                    DropdownButtonFormField<String>(
                      initialValue: tradeType,
                      decoration: const InputDecoration(
                        labelText: "Trade Type",
                        prefixIcon: Icon(Icons.swap_vert),
                        border: OutlineInputBorder(),
                      ),
                      items: const [
                        DropdownMenuItem(
                          value: "BUY",
                          child: Text("BUY"),
                        ),
                        DropdownMenuItem(
                          value: "SELL",
                          child: Text("SELL"),
                        ),
                      ],
                      onChanged: (value) {
                        if (value != null) {
                          setDialogState(() {
                            tradeType = value;
                          });
                        }
                      },
                    ),

                    const SizedBox(height: 12),

                    TextField(
                      controller: entryController,
                      keyboardType:
                          const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: const InputDecoration(
                        labelText: "Entry Price",
                        prefixIcon: Icon(Icons.login),
                        border: OutlineInputBorder(),
                      ),
                    ),

                    const SizedBox(height: 12),

                    TextField(
                      controller: exitController,
                      keyboardType:
                          const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: const InputDecoration(
                        labelText: "Exit Price",
                        prefixIcon: Icon(Icons.logout),
                        border: OutlineInputBorder(),
                      ),
                    ),

                    const SizedBox(height: 12),

                    TextField(
                      controller: profitLossController,
                      keyboardType:
                          const TextInputType.numberWithOptions(
                        decimal: true,
                        signed: true,
                      ),
                      decoration: const InputDecoration(
                        labelText: "Profit / Loss",
                        hintText: "Example: 120 or -45",
                        prefixText: "\$ ",
                        prefixIcon: Icon(Icons.attach_money),
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(dialogContext);
                  },
                  child: const Text("Cancel"),
                ),
                ElevatedButton.icon(
                  onPressed: () {
                    final symbol =
                        symbolController.text.trim().toUpperCase();

                    final entry =
                        double.tryParse(entryController.text);

                    final exit =
                        double.tryParse(exitController.text);

                    final profitLoss =
                        double.tryParse(
                      profitLossController.text,
                    );

                    if (symbol.isEmpty ||
                        entry == null ||
                        exit == null ||
                        profitLoss == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            "Please enter valid trade details.",
                          ),
                        ),
                      );
                      return;
                    }

                    setState(() {
                      _trades.insert(
                        0,
                        TradeEntry(
                          symbol: symbol,
                          type: tradeType,
                          entry: entry,
                          exit: exit,
                          profitLoss: profitLoss,
                          date: DateTime.now(),
                        ),
                      );
                    });

                    Navigator.pop(dialogContext);
                  },
                  icon: const Icon(Icons.save),
                  label: const Text("Save Trade"),
                ),
              ],
            );
          },
        );
      },
    );
  }

  Future<void> _deleteTrade(int index) async {
    final shouldDelete = await showDialog<bool>(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text("Delete Trade?"),
          content: const Text(
            "Are you sure you want to delete this trade?",
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context, false);
              },
              child: const Text("Cancel"),
            ),
            ElevatedButton(
              onPressed: () {
                Navigator.pop(context, true);
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red,
              ),
              child: const Text("Delete"),
            ),
          ],
        );
      },
    );

    if (shouldDelete == true) {
      setState(() {
        _trades.removeAt(index);
      });
    }
  }

  double get _totalProfit {
    return _trades.fold(
      0,
      (total, trade) => total + trade.profitLoss,
    );
  }

  int get _winningTrades {
    return _trades
        .where((trade) => trade.profitLoss > 0)
        .length;
  }

  int get _losingTrades {
    return _trades
        .where((trade) => trade.profitLoss < 0)
        .length;
  }

  @override
  Widget build(BuildContext context) {
    final isOverallProfit = _totalProfit >= 0;

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "Trading Journal",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
      ),
      body: Column(
        children: [
          if (_trades.isNotEmpty)
            Padding(
              padding: const EdgeInsets.fromLTRB(
                16,
                16,
                16,
                8,
              ),
              child: _buildSummaryCard(isOverallProfit),
            ),

          Expanded(
            child: _trades.isEmpty
                ? _buildEmptyState()
                : ListView.builder(
                    padding: const EdgeInsets.fromLTRB(
                      16,
                      8,
                      16,
                      100,
                    ),
                    itemCount: _trades.length,
                    itemBuilder: (context, index) {
                      return _buildTradeCard(
                        _trades[index],
                        index,
                      );
                    },
                  ),
          ),
        ],
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: _showAddTradeDialog,
        icon: const Icon(Icons.add),
        label: const Text("Add Trade"),
      ),
    );
  }

  Widget _buildSummaryCard(bool isProfit) {
    return Card(
      elevation: 5,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
      ),
      child: Padding(
        padding: const EdgeInsets.all(18),
        child: Column(
          children: [
            const Row(
              children: [
                Icon(
                  Icons.analytics,
                  color: Colors.amber,
                ),
                SizedBox(width: 8),
                Text(
                  "Trading Summary",
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),

            const SizedBox(height: 18),

            Row(
              children: [
                Expanded(
                  child: _summaryItem(
                    "Total P/L",
                    "${isProfit ? '+' : ''}\$"
                        "${_totalProfit.toStringAsFixed(2)}",
                    isProfit ? Colors.green : Colors.red,
                  ),
                ),
                Expanded(
                  child: _summaryItem(
                    "Trades",
                    "${_trades.length}",
                    Colors.blue,
                  ),
                ),
              ],
            ),

            const SizedBox(height: 14),

            Row(
              children: [
                Expanded(
                  child: _summaryItem(
                    "Wins",
                    "$_winningTrades",
                    Colors.green,
                  ),
                ),
                Expanded(
                  child: _summaryItem(
                    "Losses",
                    "$_losingTrades",
                    Colors.red,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _summaryItem(
    String title,
    String value,
    Color color,
  ) {
    return Column(
      children: [
        Text(
          title,
          style: const TextStyle(
            color: Colors.white60,
            fontSize: 13,
          ),
        ),
        const SizedBox(height: 5),
        Text(
          value,
          style: TextStyle(
            color: color,
            fontSize: 19,
            fontWeight: FontWeight.bold,
          ),
        ),
      ],
    );
  }

  Widget _buildEmptyState() {
    return const Center(
      child: Padding(
        padding: EdgeInsets.all(24),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(
              Icons.book_outlined,
              size: 75,
              color: Colors.amber,
            ),
            SizedBox(height: 18),
            Text(
              "No trades yet",
              style: TextStyle(
                fontSize: 23,
                fontWeight: FontWeight.bold,
              ),
            ),
            SizedBox(height: 8),
            Text(
              "Tap the Add Trade button to record "
              "your first trade.",
              textAlign: TextAlign.center,
              style: TextStyle(
                color: Colors.white60,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTradeCard(
    TradeEntry trade,
    int index,
  ) {
    final isProfit = trade.profitLoss >= 0;
    final isBuy = trade.type == "BUY";

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      elevation: 3,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
      ),
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Row(
          children: [
            CircleAvatar(
              radius: 26,
              backgroundColor:
                  isBuy ? Colors.green : Colors.red,
              child: Icon(
                isBuy
                    ? Icons.trending_up
                    : Icons.trending_down,
                color: Colors.white,
              ),
            ),

            const SizedBox(width: 14),

            Expanded(
              child: Column(
                crossAxisAlignment:
                    CrossAxisAlignment.start,
                children: [
                  Text(
                    "${trade.symbol} - ${trade.type}",
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                    ),
                  ),

                  const SizedBox(height: 6),

                  Text(
                    "Entry: ${trade.entry}\n"
                    "Exit: ${trade.exit}\n"
                    "Date: ${_formatDate(trade.date)}",
                    style: const TextStyle(
                      color: Colors.white60,
                      fontSize: 12,
                    ),
                  ),
                ],
              ),
            ),

            const SizedBox(width: 8),

            Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text(
                  "${isProfit ? '+' : ''}\$"
                  "${trade.profitLoss.toStringAsFixed(2)}",
                  style: TextStyle(
                    color:
                        isProfit ? Colors.green : Colors.red,
                    fontWeight: FontWeight.bold,
                    fontSize: 15,
                  ),
                ),

                IconButton(
                  tooltip: "Delete trade",
                  icon: const Icon(
                    Icons.delete_outline,
                    color: Colors.redAccent,
                    size: 21,
                  ),
                  onPressed: () => _deleteTrade(index),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  String _formatDate(DateTime date) {
    return "${date.day.toString().padLeft(2, '0')}/"
        "${date.month.toString().padLeft(2, '0')}/"
        "${date.year}";
  }
}

class TradeEntry {
  final String symbol;
  final String type;
  final double entry;
  final double exit;
  final double profitLoss;
  final DateTime date;

  TradeEntry({
    required this.symbol,
    required this.type,
    required this.entry,
    required this.exit,
    required this.profitLoss,
    required this.date,
  });
}