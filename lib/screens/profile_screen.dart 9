import 'package:flutter/material.dart';

import 'settings_screen.dart';
import 'journal_screen.dart';
import 'risk_calculator_screen.dart';
import 'lot_size_calculator_screen.dart';
import 'economic_calendar_screen.dart';
import 'forex_news_screen.dart';
import 'notifications_screen.dart';

class ProfileScreen extends StatelessWidget {
  const ProfileScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "My Profile",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const CircleAvatar(
            radius: 50,
            backgroundColor: Colors.amber,
            child: Icon(
              Icons.person,
              size: 50,
              color: Colors.black,
            ),
          ),

          const SizedBox(height: 16),

          const Center(
            child: Text(
              "Welcome to Jibwis AI",
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),

          const SizedBox(height: 6),

          const Center(
            child: Text(
              "Your trading journey starts here.",
              style: TextStyle(
                color: Colors.white70,
              ),
            ),
          ),

          const SizedBox(height: 25),

          Card(
            child: Column(
              children: const [
                ListTile(
                  leading: Icon(Icons.email),
                  title: Text("Email"),
                  subtitle: Text("Not logged in"),
                ),
                Divider(height: 1),
                ListTile(
                  leading: Icon(
                    Icons.workspace_premium,
                    color: Colors.amber,
                  ),
                  title: Text("VIP Status"),
                  subtitle: Text("Free Plan"),
                ),
              ],
            ),
          ),

          const SizedBox(height: 12),

          _profileItem(
            context,
            icon: Icons.settings,
            title: "Settings",
            page: const SettingsScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.book,
            title: "Trading Journal",
            page: const JournalScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.calculate,
            title: "Risk Calculator",
            page: const RiskCalculatorScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.straighten,
            title: "Lot Size Calculator",
            page: const LotSizeCalculatorScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.calendar_month,
            title: "Economic Calendar",
            page: const EconomicCalendarScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.newspaper,
            title: "Forex News",
            page: const ForexNewsScreen(),
          ),

          _profileItem(
            context,
            icon: Icons.notifications,
            title: "Notifications",
            page: const NotificationsScreen(),
          ),

          const SizedBox(height: 20),

          const Center(
            child: Text(
              "Jibwis AI • Version 1.0",
              style: TextStyle(
                color: Colors.white54,
              ),
            ),
          ),

          const SizedBox(height: 20),
        ],
      ),
    );
  }

  static Widget _profileItem(
    BuildContext context, {
    required IconData icon,
    required String title,
    required Widget page,
  }) {
    return Card(
      margin: const EdgeInsets.only(bottom: 8),
      child: ListTile(
        leading: Icon(icon),
        title: Text(title),
        trailing: const Icon(
          Icons.arrow_forward_ios,
          size: 16,
        ),
        onTap: () {
          Navigator.push(
            context,
            MaterialPageRoute(
              builder: (context) => page,
            ),
          );
        },
      ),
    );
  }
}