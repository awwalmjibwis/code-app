import 'package:flutter/material.dart';

class LotSizeCalculatorScreen extends StatefulWidget {
  const LotSizeCalculatorScreen({super.key});

  @override
  State<LotSizeCalculatorScreen> createState() =>
      _LotSizeCalculatorScreenState();
}

class _LotSizeCalculatorScreenState
    extends State<LotSizeCalculatorScreen> {
  final TextEditingController _balanceController =
      TextEditingController();

  final TextEditingController _riskController =
      TextEditingController();

  final TextEditingController _entryController =
      TextEditingController();

  final TextEditingController _stopLossController =
      TextEditingController();

  final TextEditingController _pipValueController =
      TextEditingController();

  double? _lotSize;
  double? _riskAmount;
  double? _stopDistance;

  @override
  void dispose() {
    _balanceController.dispose();
    _riskController.dispose();
    _entryController.dispose();
    _stopLossController.dispose();
    _pipValueController.dispose();
    super.dispose();
  }

  void _calculateLotSize() {
    final balance =
        double.tryParse(_balanceController.text.trim());

    final riskPercent =
        double.tryParse(_riskController.text.trim());

    final entry =
        double.tryParse(_entryController.text.trim());

    final stopLoss =
        double.tryParse(_stopLossController.text.trim());

    final pipValue =
        double.tryParse(_pipValueController.text.trim());

    if (balance == null ||
        riskPercent == null ||
        entry == null ||
        stopLoss == null ||
        pipValue == null ||
        balance <= 0 ||
        riskPercent <= 0 ||
        entry <= 0 ||
        stopLoss <= 0 ||
        pipValue <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            "Please enter valid values in all fields.",
          ),
        ),
      );
      return;
    }

    if (riskPercent > 100) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            "Risk percentage cannot be greater than 100%.",
          ),
        ),
      );
      return;
    }

    final stopDistance = (entry - stopLoss).abs();

    if (stopDistance == 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            "Entry Price and Stop Loss cannot be the same.",
          ),
        ),
      );
      return;
    }

    final riskAmount =
        balance * riskPercent / 100;

    final lotSize =
        riskAmount / (stopDistance * pipValue);

    setState(() {
      _riskAmount = riskAmount;
      _stopDistance = stopDistance;
      _lotSize = lotSize;
    });
  }

  void _clear() {
    _balanceController.clear();
    _riskController.clear();
    _entryController.clear();
    _stopLossController.clear();
    _pipValueController.clear();

    setState(() {
      _lotSize = null;
      _riskAmount = null;
      _stopDistance = null;
    });
  }

