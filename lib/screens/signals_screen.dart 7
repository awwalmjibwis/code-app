import 'package:flutter/material.dart';

class SignalsScreen extends StatelessWidget {
  const SignalsScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "Trading Signals",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const Text(
            "Latest Signals",
            style: TextStyle(
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 6),

          const Text(
            "Trading ideas powered by Jibwis AI.",
            style: TextStyle(
              color: Colors.white70,
            ),
          ),

          const SizedBox(height: 20),

          _signalCard(
            symbol: "XAU/USD",
            type: "BUY",
            entry: "2455.00",
            stopLoss: "2445.00",
            takeProfit: "2480.00",
            risk: "Medium",
            time: "10:30 AM",
            color: Colors.green,
          ),

          const SizedBox(height: 14),

          _signalCard(
            symbol: "EUR/USD",
            type: "SELL",
            entry: "1.1690",
            stopLoss: "1.1730",
            takeProfit: "1.1620",
            risk: "Low",
            time: "09:45 AM",
            color: Colors.red,
          ),

          const SizedBox(height: 14),

          _signalCard(
            symbol: "GBP/USD",
            type: "BUY",
            entry: "1.3420",
            stopLoss: "1.3370",
            takeProfit: "1.3510",
            risk: "Medium",
            time: "08:30 AM",
            color: Colors.green,
          ),

          const SizedBox(height: 14),

          _signalCard(
            symbol: "BTC/USD",
            type: "BUY",
            entry: "118450",
            stopLoss: "116800",
            takeProfit: "122000",
            risk: "High",
            time: "07:15 AM",
            color: Colors.green,
          ),

          const SizedBox(height: 20),

          Card(
            color: Colors.orange.withValues(alpha: 0.12),
            child: const Padding(
              padding: EdgeInsets.all(16),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Icon(
                    Icons.warning_amber,
                    color: Colors.orange,
                  ),
                  SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      "Trading signals are for educational purposes. "
                      "Always use proper risk management before entering a trade.",
                      style: TextStyle(
                        color: Colors.orange,
                        height: 1.4,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _signalCard({
    required String symbol,
    required String type,
    required String entry,
    required String stopLoss,
    required String takeProfit,
    required String risk,
    required String time,
    required Color color,
  }) {
    return Card(
      elevation: 3,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            Row(
              children: [
                CircleAvatar(
                  backgroundColor: color,
                  child: Icon(
                    type == "BUY"
                        ? Icons.trending_up
                        : Icons.trending_down,
                    color: Colors.white,
                  ),
                ),

                const SizedBox(width: 12),

                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,
                    children: [
                      Text(
                        symbol,
                        style: const TextStyle(
                          fontSize: 19,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      Text(
                        time,
                        style: const TextStyle(
                          color: Colors.white60,
                        ),
                      ),
                    ],
                  ),
                ),

                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 14,
                    vertical: 7,
                  ),
                  decoration: BoxDecoration(
                    color: color.withValues(alpha: 0.15),
                    borderRadius: BorderRadius.circular(20),
                  ),
                  child: Text(
                    type,
                    style: TextStyle(
                      color: color,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ],
            ),

            const SizedBox(height: 18),

            const Divider(),

            const SizedBox(height: 10),

            Row(
              mainAxisAlignment:
                  MainAxisAlignment.spaceBetween,
              children: [
                _infoItem(
                  "Entry",
                  entry,
                  Icons.login,
                ),
                _infoItem(
                  "Stop Loss",
                  stopLoss,
                  Icons.stop_circle_outlined,
                ),
                _infoItem(
                  "Take Profit",
                  takeProfit,
                  Icons.flag_outlined,
                ),
              ],
            ),

            const SizedBox(height: 16),

            Row(
              children: [
                const Icon(
                  Icons.shield_outlined,
                  size: 20,
                  color: Colors.amber,
                ),

                const SizedBox(width: 8),

                const Text(
                  "Risk:",
                  style: TextStyle(
                    color: Colors.white70,
                  ),
                ),

                const SizedBox(width: 5),

                Text(
                  risk,
                  style: TextStyle(
                    color: risk == "High"
                        ? Colors.red
                        : risk == "Medium"
                            ? Colors.orange
                            : Colors.green,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                const Spacer(),

                Text(
                  "Jibwis AI",
                  style: TextStyle(
                    color: Colors.amber.shade400,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _infoItem(
    String title,
    String value,
    IconData icon,
  ) {
    return Column(
      children: [
        Icon(
          icon,
          size: 18,
          color: Colors.white54,
        ),

        const SizedBox(height: 5),

        Text(
          title,
          style: const TextStyle(
            fontSize: 11,
            color: Colors.white54,
          ),
        ),

        const SizedBox(height: 3),

        Text(
          value,
          style: const TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
      ],
    );
  }
}