import 'package:flutter/material.dart';

class SignalsScreen extends StatelessWidget {
  const SignalsScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "Trading Signals",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const Text(
            "Latest Signals",
            style: TextStyle(
              fontSize: 22,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 8),

          const Text(
            "Review trading ideas and manage your risk carefully.",
            style: TextStyle(
              color: Colors.white70,
            ),
          ),

          const SizedBox(height: 20),

          _signalCard(
            symbol: "XAU/USD",
            direction: "BUY",
            entry: "2350.50",
            stopLoss: "2340.00",
            takeProfit: "2370.00",
            confidence: "High",
            color: Colors.green,
          ),

          _signalCard(
            symbol: "EUR/USD",
            direction: "BUY",
            entry: "1.0850",
            stopLoss: "1.0810",
            takeProfit: "1.0920",
            confidence: "Medium",
            color: Colors.blue,
          ),

          _signalCard(
            symbol: "GBP/USD",
            direction: "SELL",
            entry: "1.2740",
            stopLoss: "1.2790",
            takeProfit: "1.2650",
            confidence: "Medium",
            color: Colors.red,
          ),

          const SizedBox(height: 20),

          const Card(
            child: Padding(
              padding: EdgeInsets.all(16),
              child: Row(
                crossAxisAlignment:
                    CrossAxisAlignment.start,
                children: [
                  Icon(
                    Icons.warning_amber,
                    color: Colors.amber,
                  ),
                  SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      "Signals shown here are demo ideas "
                      "for the current app version. They are "
                      "not financial advice. Always perform "
                      "your own analysis and use proper risk management.",
                      style: TextStyle(
                        color: Colors.white70,
                        height: 1.4,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _signalCard({
    required String symbol,
    required String direction,
    required String entry,
    required String stopLoss,
    required String takeProfit,
    required String confidence,
    required Color color,
  }) {
    final isBuy = direction == "BUY";

    return Card(
      margin: const EdgeInsets.only(bottom: 14),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                CircleAvatar(
                  backgroundColor:
                      color.withValues(alpha: 0.15),
                  child: Icon(
                    isBuy
                        ? Icons.trending_up
                        : Icons.trending_down,
                    color: color,
                  ),
                ),

                const SizedBox(width: 12),

                Expanded(
                  child: Text(
                    symbol,
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),

                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 6,
                  ),
                  decoration: BoxDecoration(
                    color:
                        color.withValues(alpha: 0.15),
                    borderRadius:
                        BorderRadius.circular(10),
                  ),
                  child: Text(
                    direction,
                    style: TextStyle(
                      color: color,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ],
            ),

            const SizedBox(height: 18),

            _signalRow(
              "Entry",
              entry,
            ),

            const SizedBox(height: 8),

            _signalRow(
              "Stop Loss",
              stopLoss,
            ),

            const SizedBox(height: 8),

            _signalRow(
              "Take Profit",
              takeProfit,
            ),

            const Divider(height: 25),

            Row(
              mainAxisAlignment:
                  MainAxisAlignment.spaceBetween,
              children: [
                const Text(
                  "Confidence",
                  style: TextStyle(
                    color: Colors.white70,
                  ),
                ),
                Text(
                  confidence,
                  style: TextStyle(
                    color: color,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _signalRow(
    String title,
    String value,
  ) {
    return Row(
      mainAxisAlignment:
          MainAxisAlignment.spaceBetween,
      children: [
        Text(
          title,
          style: const TextStyle(
            color: Colors.white70,
          ),
        ),
        Text(
          value,
          style: const TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
      ],
    );
  }
}